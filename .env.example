# ==============================================================================
# LIFEKEEPER - CONFIGURACIÓN DEL SERVIDOR Y ENTORNO
# ==============================================================================

# Clave secreta para firmar las sesiones en la nube (JWT). OBLIGATORIO definir una propia.
# Generala con:  node scripts/gen-secrets.mjs   (la agrega a tu .env sin mostrarla)
# Si queda vacía, el servidor usa una clave aleatoria temporal y las sesiones se cierran al reiniciar.
JWT_SECRET=

# Contraseña de PostgreSQL. OJO: solo se aplica al CREAR la base por primera vez; cambiarla acá no
# cambia la de una base que ya existe. Para rotarla en una instalación en marcha:
#   docker compose exec postgres psql -U lifekeeper_admin -d lifekeeper_vault -c "ALTER USER lifekeeper_admin PASSWORD 'nueva';"
# y después poner la misma 'nueva' acá y reiniciar la api.
# POSTGRES_PASSWORD=

# Orígenes extra permitidos por CORS (separados por coma), además de app.lifekeeper.lat, la red local y la APK.
# CORS_ORIGINS=https://mi-dominio.com

# Cantidad de proxies delante de la API (nginx = 1; con Cloudflare/túnel delante de nginx, 2).
# Sirve para ver la IP real del cliente y limitar intentos por IP.
# TRUST_PROXY=1

# ------------------------------------------------------------------------------
# SERVICIO DE CORREO TRANSACCIONAL (Resend / SMTP)
# ------------------------------------------------------------------------------
# Pega tu API Key de Resend aquí (empieza con re_...):
RESEND_API_KEY=

# Dirección de remitente verificada en tu dominio
SMTP_FROM=LifeKeeper <no-reply@lifekeeper.lat>

# (Opcional) Si usas SMTP tradicional en lugar de Resend API:
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=resend
# SMTP_PASS=
