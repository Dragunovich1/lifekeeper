# ==============================================================================
# LIFEKEEPER - CONFIGURACIÓN DEL SERVIDOR Y ENTORNO
# ==============================================================================

# Clave secreta para generación de tokens de sesión JWT
JWT_SECRET=lifekeeper_super_secure_jwt_secret_2026_xyz

# Base de datos PostgreSQL interna (Zero-Knowledge)
DATABASE_URL=postgres://lifekeeper_admin:lifekeeper_secure_password_2026@postgres:5432/lifekeeper_vault

# ------------------------------------------------------------------------------
# SERVICIO DE CORREO TRANSACCIONAL (Resend / SMTP)
# ------------------------------------------------------------------------------
# Pega tu API Key de Resend aquí (empieza con re_...):
RESEND_API_KEY=

# Dirección de remitente verificada en tu dominio
SMTP_FROM=LifeKeeper <no-reply@lifekeeper.lat>

# (Opcional) Si usas SMTP tradicional en lugar de Resend API:
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=resend
# SMTP_PASS=
